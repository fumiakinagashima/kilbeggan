{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kilbeggan",
	"compatibility_date": "2026-06-22",
	"compatibility_flags": ["nodejs_als"],
	"main": "worker.ts",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Reminder delivery: checks for pending reminders every minute and sends any that have reached remind_at
	"triggers": {
		"crons": ["* * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kilbeggan",
			"database_id": "YOUR_D1_DATABASE_ID",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "kilbeggan",
			"id": "YOUR_KV_NAMESPACE_ID"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "your-r2-bucket-name"
		}
	]
}
