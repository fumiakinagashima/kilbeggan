{
	"name": "kilbeggan",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "(svelte-kit sync || echo '') && bun run scripts/ensure-worker-shim.ts",
		"check": "wrangler types --check && svelte-kit sync && bun run scripts/ensure-worker-shim.ts && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && bun run scripts/ensure-worker-shim.ts && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push --config=drizzle.local.config.ts",
		"db:migrate:local": "wrangler d1 migrations apply kilbeggan --local",
		"db:migrate:remote": "wrangler d1 execute kilbeggan --remote --file",
		"db:studio": "drizzle-kit studio --config=drizzle.local.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@libsql/client": "^0.17.4",
		"@lucide/svelte": "^1.21.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass-embedded": "^1.100.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.105.0",
		"@block65/webcrypto-web-push": "^1.0.2",
		"zod": "^4.4.3"
	}
}
